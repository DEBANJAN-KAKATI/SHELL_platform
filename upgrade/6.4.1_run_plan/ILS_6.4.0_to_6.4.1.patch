+                <td>${hasValue(r.type) ? `<span class="rp-type t-${TYPE_CLASS[String(r.type).toLowerCase()] || 'x'}">${esc(r.type)}</span>` : ''}</td>
+                ${barCell(r.weight, maxLiquid)}
