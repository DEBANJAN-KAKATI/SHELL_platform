+
+    // Gas feed composition + gas feed settings
+    const gas = (t.gas?.rows || []).filter(g => (g.component || feedShowEmpty) && keep(g.value, g.component));
+    const maxGas = Math.max(0, ...gas.map(g => Number(g.value)).filter(Number.isFinite));
