+    return `<td class="rp-num">${hasValue(value) ? fmtAmount(value) : '<span class="rp-dash">—</span>'}${width ? `<span class="rp-bar"><i style="width:${width.toFixed(1)}%"></i></span>` : ''}</td>`;
+}
+
