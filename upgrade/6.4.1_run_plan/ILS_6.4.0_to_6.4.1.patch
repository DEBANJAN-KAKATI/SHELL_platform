+                f'IF(B{r}="Block-2",IF(ISNUMBER($H${ROW["start"]}),$H${ROW["start"]}+{col}{r}/24,""),""))')
+    put(f"A{r}", r - R0 + 1, "calc", "0")
+    put(f"B{r}", None, "inp")
+    put(f"C{r}", f'=IF(ISNUMBER(R{r}),{date_of("R")},"")', "date_calc", NUM["date"])
+    put(f"D{r}", f'=IF(ISNUMBER(S{r}),{date_of("S")},"")', "date_calc", NUM["date"])
